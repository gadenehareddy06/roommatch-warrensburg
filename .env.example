# Public browser-safe Supabase values. Never use a secret or service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Older Supabase projects can use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Set to /roommatch-warrensburg/ when deploying to https://USERNAME.github.io/roommatch-warrensburg/
VITE_BASE_PATH=/
